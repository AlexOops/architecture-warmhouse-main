@startuml SmartHome_ER

title ER-диаграмма экосистемы "Тёплый дом" (To-Be)

entity "User" as user {
  * id : UUID
  --
  email : string
  password_hash : string
  full_name : string
  created_at : datetime
  is_active : bool
}

entity "House" as house {
  * id : UUID
  --
  user_id : UUID <<FK -> User.id>>
  name : string
  address : string
  timezone : string
  created_at : datetime
}

entity "Device" as device {
  * id : UUID
  --
  house_id : UUID <<FK -> House.id>>
  device_type_id : UUID <<FK -> DeviceType.id>>
  name : string
  serial_number : string
  status : string        ' e.g. online/offline
  location : string      ' комната/зона
  last_seen_at : datetime
}

entity "DeviceType" as devtype {
  * id : UUID
  --
  code : string          ' e.g. TEMPERATURE_SENSOR, HEATING_RELAY
  name : string
  category : string      ' sensor / actuator / camera / gateway
  supports_telemetry : bool
  supports_commands : bool
}

entity "Module" as module {
  * id : UUID
  --
  code : string          ' HEATING, LIGHTING, GATES, SURVEILLANCE
  name : string
  description : string
  is_active : bool
}

entity "HouseModule" as housemodule {
  * id : UUID
  --
  house_id : UUID <<FK -> House.id>>
  module_id : UUID <<FK -> Module.id>>
  status : string        ' active / expired / pending
  valid_from : datetime
  valid_to : datetime
}

entity "TelemetryData" as telemetry {
  * id : UUID
  --
  device_id : UUID <<FK -> Device.id>>
  recorded_at : datetime
  metric_key : string    ' temperature, humidity, state и т.п.
  metric_value : string  ' храним в виде строки / JSON
  unit : string          ' °C, %, boolean, etc.
}

' Связи
user ||--o{ house : "владеет"
house ||--o{ device : "содержит"
devtype ||--o{ device : "тип для"
device ||--o{ telemetry : "генерирует"
house ||--o{ housemodule : "подключены"
module ||--o{ housemodule : "используется в"

@enduml
